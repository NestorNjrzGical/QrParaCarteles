<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bgGradient2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f5576c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bgGradient2)"/>
  
  <!-- Cara -->
  <circle cx="300" cy="100" r="40" fill="#f4a460"/>
  
  <!-- Ojos -->
  <circle cx="285" cy="90" r="5" fill="#333"/>
  <circle cx="315" cy="90" r="5" fill="#333"/>
  
  <!-- Boca -->
  <path d="M 285 110 Q 300 120 315 110" stroke="#333" stroke-width="3" fill="none" stroke-linecap="round"/>
  
  <!-- Espuma de afeitar -->
  <circle cx="270" cy="120" r="8" fill="#fff" opacity="0.9"/>
  <circle cx="280" cy="125" r="6" fill="#fff" opacity="0.9"/>
  <circle cx="290" cy="128" r="7" fill="#fff" opacity="0.9"/>
  <circle cx="300" cy="130" r="8" fill="#fff" opacity="0.9"/>
  <circle cx="310" cy="128" r="7" fill="#fff" opacity="0.9"/>
  <circle cx="320" cy="125" r="6" fill="#fff" opacity="0.9"/>
  <circle cx="330" cy="120" r="8" fill="#fff" opacity="0.9"/>
  
  <!-- Navaja de barbero -->
  <g transform="translate(200, 200)">
    <rect x="0" y="0" width="30" height="8" rx="4" fill="#c0c0c0"/>
    <polygon points="30,0 45,4 30,8" fill="#d4af37"/>
  </g>
  
  <!-- Brocha de afeitar -->
  <g transform="translate(400, 200)">
    <rect x="0" y="0" width="6" height="40" fill="#8b4513"/>
    <circle cx="3" cy="-8" r="10" fill="#f5deb3"/>
  </g>
  
  <!-- Texto -->
  <text x="300" y="350" font-size="28" font-weight="bold" text-anchor="middle" fill="#fff" font-family="Arial">Afeitado Artesanal</text>
</svg>